# AcctBud environment configuration
# Copy to .env and fill in values. NEVER commit .env.

# Public URL where the PWA is served (must be HTTPS for Web Push)
PUBLIC_ORIGIN=https://acctbud.your-tailnet.ts.net

# User timezone — scheduler uses this for morning/evening triggers
USER_TZ=America/New_York

# Notification schedule (HH:MM in USER_TZ)
MORNING_TIME=08:00
EVENING_TIME=20:00

# VAPID keys for Web Push (generate with: ./generate-vapid-keys.sh)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# SQLite database path (relative to backend working dir, or absolute)
DB_PATH=data/acctbud.db

# Journal / Vault path (bite 3+)
# JOURNAL_PATH=/mnt/vault/acctbud/journal
