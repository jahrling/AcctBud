# AcctBud environment configuration
# Copy to .env and fill in values. NEVER commit .env.

# Public URL where the PWA is served (must be HTTPS for Web Push)
# With path-based routing: https://<machine>.your-tailnet.ts.net/acctbud
PUBLIC_ORIGIN=https://thering.your-tailnet.ts.net

# User timezone — scheduler uses this for morning/evening triggers
USER_TZ=America/New_York

# Notification schedule (HH:MM in USER_TZ)
MORNING_TIME=08:00
EVENING_TIME=20:00

# VAPID keys for Web Push (generate with: ./generate-vapid-keys.sh)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# SQLite database path (relative to backend working dir, or absolute)
DB_PATH=data/acctbud.db

# Journal / Vault path — directory where check-in markdown entries are written.
# Points into The Vault (encrypted storage). If the path is missing or
# unwritable (Vault locked), check-ins still succeed in SQLite; pending
# journal entries are retried on a schedule and at startup.
JOURNAL_PATH=/mnt/vault/acctbud/journal

# LLM — Ollama (bite 4+)
# The backend container reaches the host-installed Ollama via extra_hosts
# mapping in docker-compose.yml.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Model name — must be pulled on the host first: ollama pull qwen3.5:9b
OLLAMA_MODEL=qwen3.5:9b
# Maximum tokens per LLM response (maps to Ollama num_predict)
OLLAMA_MAX_TOKENS=256
