# AcctBud — Caddy reverse proxy
#
# Tailscale Serve handles HTTPS termination (valid certs, port 443) and
# forwards to Caddy on port 8080.  All routes live under /acctbud so
# multiple apps can share a single Tailscale Serve host.
#
#   tailscale serve /acctbud http://localhost:8081

:8080 {
    root * /srv/pwa
    file_server

    handle /api/* {
        reverse_proxy backend:8000
    }

    try_files {path} /index.html
}
