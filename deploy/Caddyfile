# AcctBud — Caddy reverse proxy
#
# HTTPS is mandatory: iOS service workers and Web Push require a secure context.
#
# Cert options (pick one):
#   1. Tailscale cert: run `tailscale cert acctbud.your-tailnet.ts.net` and
#      point tls directives at the generated .crt/.key files.
#   2. DNS-challenge: use a Caddy DNS plugin (e.g. cloudflare) for a domain
#      you own, with TLS automated via ACME DNS-01.
#
# The placeholder below uses option 1 — adjust the hostname and cert paths.

{$SITE_ADDRESS:acctbud.tail-scale.ts.net} {
    # Serve the built PWA as static files
    root * /srv/pwa
    file_server

    # API reverse proxy
    handle /api/* {
        reverse_proxy backend:8000
    }

    # SPA fallback: non-file, non-API requests get index.html
    try_files {path} /index.html
}
