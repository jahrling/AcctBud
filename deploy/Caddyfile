# AcctBud — Caddy reverse proxy
#
# Tailscale Serve handles HTTPS termination and path-prefix stripping.
# A request to https://therig.…/acctbud/foo arrives here as /foo.
#
#   tailscale serve /acctbud http://localhost:8080

:8080 {
    handle /api/* {
        reverse_proxy backend:8000
    }

    handle {
        root * /srv/pwa
        try_files {path} /index.html
        file_server
    }
}
